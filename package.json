{
  "name": "@gosukiwi/crap4ts",
  "version": "0.2.0",
  "description": "Finds the riskiest code in your TypeScript project: code that is hard to follow and poorly tested.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gosukiwi/crap4ts"
  },
  "private": false,
  "type": "module",
  "bin": {
    "crap4ts": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "crap": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov && npm run build && node dist/cli.js src --coverage ./coverage/lcov.info --max-crap 15",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.10.0",
    "eslint-plugin-colocate": "github:gosukiwi/eslint-plugin-colocate",
    "prettier": "^3.9.6",
    "vitest": "^2.1.8"
  }
}
